/target
**/*.rs.bk
.DS_Store
.rolepod/
.claude/agent-memory/

# The embedding model is a release asset, not a repository file: 122 MB is
# past what GitHub accepts and would sit in every clone forever. Fetch it with
# `bootstrap.sh --model-only --into assets` — the checksums are in PROVENANCE.
assets/*/model-int8.safetensors
assets/*/tokenizer.json
# Same rule for the reranker, and more so: 569 MB, fetched only by machines
# that actually turn reranking on. `bootstrap.sh --reranker-only`.
assets/*/model.onnx
assets/*/model.onnx.data
